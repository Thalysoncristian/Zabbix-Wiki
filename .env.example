# =============================================================================
# Zabbix Alert Knowledge Base — ETAPA 1 (coleta read-only)
# Copie este arquivo para .env e preencha com os dados do seu ambiente.
#   cp .env.example .env
# O arquivo .env NUNCA deve ser versionado (já está no .gitignore).
# =============================================================================

# URL base do Zabbix (com ou sem /api_jsonrpc.php — o cliente resolve os dois)
ZABBIX_URL=https://zabbix.suaempresa.com.br

# -----------------------------------------------------------------------------
# Autenticação — PREFERIR API TOKEN
# -----------------------------------------------------------------------------
# Zabbix >= 5.4: Administração > Geral > Tokens de API.
# Crie um token para um usuário com perfil de leitura (papel "User" / somente
# leitura nos grupos de hosts desejados). O coletor é 100% read-only.
ZABBIX_API_TOKEN=

# Fallback (usado SOMENTE se ZABBIX_API_TOKEN estiver vazio).
# Nesse caso o cliente usa user.login/user.logout para abrir uma sessão.
ZABBIX_USER=
ZABBIX_PASSWORD=

# -----------------------------------------------------------------------------
# Opcionais
# -----------------------------------------------------------------------------
# true | false | /caminho/para/ca-bundle.crt
ZABBIX_VERIFY_TLS=true

# Timeout de cada requisição HTTP, em segundos
ZABBIX_TIMEOUT=30

# Tamanho do lote ao consultar por listas de IDs (hosts, itens, templates...)
ZABBIX_PAGE_SIZE=500

# Hosts por chamada trigger.get na coleta completa (sem --limit). Em ambientes
# grandes, pedir os triggers de milhares de hosts numa única chamada pode
# devolver HTTP 500 (timeout/memória) do servidor Zabbix. Se isso acontecer
# mesmo com o padrão, reduza este valor (ex.: 20 ou 10).
ZABBIX_TRIGGER_BATCH_SIZE=50

# Filtro opcional de coleta: apenas estes grupos de hosts (separados por vírgula)
# Ex.: ZABBIX_HOST_GROUPS=Infraestrutura,Servidores Linux
ZABBIX_HOST_GROUPS=

# Diretório raiz de saída dos snapshots
OUTPUT_DIR=output
